{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Run bot on practice questions (questions.json -> answers.json)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["questions.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "2. Quick test (10 hard chats, ~2 min)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["questions.json"],
      "cwd": "${workspaceFolder}/tests/quick",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "3. Full hard test (28 chats, ~6 min)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["questions.json"],
      "cwd": "${workspaceFolder}/tests/hard",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "4. Routing check (instant, no model)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_route.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
